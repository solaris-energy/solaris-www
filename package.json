{
  "name": "solaris-www",
  "version": "0.1.0",
  "private": true,
  "description": "Public marketing site for SOLARIS — the industrial-solar intelligence platform.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.11.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "check:budgets": "node scripts/check-budgets.mjs",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "pages:build": "npx @cloudflare/next-on-pages",
    "pages:deploy": "wrangler pages deploy .vercel/output/static"
  },
  "dependencies": {
    "@mdx-js/loader": "3.1.0",
    "@mdx-js/react": "3.1.0",
    "@next/mdx": "15.1.4",
    "clsx": "2.1.1",
    "framer-motion": "11.15.0",
    "gsap": "3.12.5",
    "maplibre-gl": "^5.24.0",
    "next": "^15.5.18",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "1.13.7",
    "@lhci/cli": "0.14.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "22.10.5",
    "@types/react": "19.0.4",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "10.4.20",
    "eslint": "9.17.0",
    "eslint-config-next": "^15.5.18",
    "postcss": "8.4.49",
    "prettier": "3.4.2",
    "prettier-plugin-tailwindcss": "0.6.9",
    "tailwindcss": "4.3.0",
    "typescript": "5.7.3",
    "wrangler": "3.99.0"
  }
}
